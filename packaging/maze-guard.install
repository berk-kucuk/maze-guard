#!/usr/bin/env bash
# Maze Guard post-install hooks — group setup and the helper daemon.
#
# Python libraries are NOT installed here any more: they come from the
# maze-python package (the shared /opt/maze/venv), which pacman tracks like
# any other files. There is nothing to pip, chmod or link.

_INSTALL_DIR="/opt/maze-guard"

# ── helpers ───────────────────────────────────────────────────────────────────

_info()  { echo "  [maze-guard] $*"; }
_warn()  { echo "  [maze-guard] WARNING: $*"; }
_ok()    { echo "  [maze-guard] ✓ $*"; }

_refresh_desktop() {
    command -v gtk-update-icon-cache &>/dev/null && \
        gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
    command -v update-desktop-database &>/dev/null && \
        update-desktop-database /usr/share/applications 2>/dev/null || true
}

_setup_group() {
    # systemd-sysusers normally creates 'maze' from /usr/lib/sysusers.d/maze-guard.conf.
    # That hook runs as a PostTransaction hook, i.e. AFTER this post_install runs,
    # so the group is NOT guaranteed to exist yet when we get here — create it
    # ourselves (idempotent) so ordering never matters.
    getent group maze >/dev/null 2>&1 || groupadd -r maze 2>/dev/null || true
}

# Best-effort discovery of the unprivileged desktop user pacman/the AUR helper
# was invoked for.
_real_user() {
    if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
        echo "$SUDO_USER"
        return
    fi
    logname 2>/dev/null || true
}

# Actually add the user to the group instead of just printing instructions —
# so the daemon socket works right after install/reboot with no manual step.
_add_user_to_group() {
    local real_user
    real_user="$(_real_user)"
    if [ -n "$real_user" ]; then
        if usermod -aG maze "$real_user" 2>/dev/null; then
            _ok "Added '$real_user' to the 'maze' group"
        else
            _warn "Could not add '$real_user' to 'maze' automatically — run: sudo usermod -aG maze $real_user"
        fi
    else
        _warn "Could not determine the installing user — add yourself manually: sudo usermod -aG maze <your-user>"
    fi
}

_enable_daemon() {
    systemctl daemon-reload 2>/dev/null || true
    systemctl enable --now maze-guard.service 2>/dev/null \
        && _ok "maze-guard.service enabled and started" \
        || _warn "Could not enable maze-guard.service automatically — run: sudo systemctl enable --now maze-guard.service"
}

# Put the freshly installed helper into service.
#
# `systemctl try-restart` — what this used to do — is a no-op when the unit is
# enabled but not currently running, which is exactly the state left behind by a
# crash, a manual stop, or an install whose first start failed. The upgrade then
# reported success while the machine had no helper at all. Decide from the unit's
# actual state instead, and never start a daemon the user deliberately disabled.
_restart_daemon() {
    systemctl daemon-reload 2>/dev/null || true

    local action=""
    if systemctl is-active --quiet maze-guard.service 2>/dev/null; then
        action="restart"
    elif systemctl is-enabled --quiet maze-guard.service 2>/dev/null; then
        action="start"
    else
        _info "maze-guard.service is disabled — leaving it alone"
        return
    fi

    if systemctl "$action" maze-guard.service 2>/dev/null \
       && systemctl is-active --quiet maze-guard.service 2>/dev/null; then
        _ok "maze-guard.service is running the new build"
    else
        _warn "maze-guard.service did not come up — check: journalctl -u maze-guard.service -e"
        _warn "Until it does, Maze Guard runs in limited (detection-only) mode."
    fi
}

_print_summary() {
    # Self-aligning box: content is ASCII-only so printf byte-width == columns.
    local w=54
    _boxline() { printf "  | %-*s |\n" "$w" "$1"; }
    local bar; bar="$(printf '%*s' "$((w+2))" '' | tr ' ' '-')"
    echo ""
    printf "  +%s+\n" "$bar"
    _boxline "Maze Guard installed - run: maze-guard"
    _boxline ""
    _boxline "The privileged helper runs as a daemon - no"
    _boxline "password prompt. Your user was added to the"
    _boxline "'maze' group automatically - log out and back"
    _boxline "in (or reboot) for it to take effect."
    _boxline ""
    _boxline "Autostart launches Maze Guard hidden in the tray."
    printf "  +%s+\n" "$bar"
    echo ""
}

# ── hooks ─────────────────────────────────────────────────────────────────────

post_install() {
    _refresh_desktop
    _setup_group
    _add_user_to_group
    _enable_daemon
    _print_summary
}

post_upgrade() {
    _refresh_desktop
    _setup_group
    _add_user_to_group
    # Pick up unit changes and put the new helper into service. This matters
    # more than it looks: the GUI and the root helper speak a versioned command
    # set, so a helper left on the old code makes newly added privileged
    # operations fail silently while everything still *looks* healthy.
    _restart_daemon
    # Only now, with the helper already running on /opt/maze/venv, drop the
    # private venv a pre-maze-python build left behind. Doing this BEFORE the
    # restart pulled the libraries out from under the old helper mid-shutdown
    # and it hung until systemd killed it 90 s later.
    if [[ -d "$_INSTALL_DIR/venv" ]]; then
        rm -rf "$_INSTALL_DIR/venv"
        _info "Removed the old private venv (libraries now come from maze-python)"
    fi
    _ok "Maze Guard upgraded"
    _info "Quit and relaunch the Maze Guard window to load the new version."
}

pre_remove() {
    # Stop and disable the daemon before its files disappear.
    systemctl disable --now maze-guard.service 2>/dev/null || true
}

post_remove() {
    systemctl daemon-reload 2>/dev/null || true
    # Only OUR socket. /run/maze is shared: maze-tools' maze-guardd listens on
    # /run/maze/guard.sock there and Maze Sentinel keeps state in it — the same
    # reason the unit carries no RuntimeDirectory=. Wiping the directory killed
    # the panic button / kill switches under a still-running maze-guardd.
    rm -f /run/maze/maze.sock 2>/dev/null || true
    rmdir /run/maze 2>/dev/null || true             # only if nothing else is left
    rm -rf "$_INSTALL_DIR/venv" 2>/dev/null || true   # pre-maze-python leftovers
    _refresh_desktop
}
