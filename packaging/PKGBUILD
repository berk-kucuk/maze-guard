# Maintainer: berkkucukk <berkkucukk@proton.me>
#
# LOCAL-BUILD PKGBUILD.
# This builds maze-guard from a source tarball generated out of the local
# working tree (see ../build-pkg.sh), NOT from a GitHub release tag. The build
# script writes the correct `pkgver` and drops `maze-guard-$pkgver.tar.gz` next
# to this file before invoking makepkg.
#
# To publish to the AUR instead, swap the source line for the tagged release
# and replace 'SKIP' with the real checksum:
#   source=("$pkgname-$pkgver.tar.gz::https://github.com/berk-kucuk/maze-guard/archive/refs/tags/v$pkgver.tar.gz")

pkgname=maze-guard
pkgver=2.19.1
pkgrel=1
pkgdesc="Maze Guard — public WiFi security monitor: MITM detection, firewalld integration"
arch=('x86_64' 'aarch64')
url="https://github.com/berk-kucuk/maze-guard"
license=('MIT')
# Renamed from the 'maze' package — replace/conflict so pacman migrates cleanly.
replaces=('maze')
conflicts=('maze')

# Python libraries come from maze-python, the shared Maze venv at
# /opt/maze/venv (PyQt6, scapy, httpx, qasync, cryptography, python-dbus).
# This package ships only its own code and runs it with that interpreter.
depends=(
    'maze-python'      # shared Python runtime: /opt/maze/venv
    'firewalld'        # firewall backend (rich rules)
    'iproute2'         # ip route / ip neigh commands
    'dbus'             # dbus daemon (runtime)
    'polkit'           # consent prompt before any protection can be turned off
    'systemd'          # runs the privileged helper as a daemon (maze-guard.service)
)
makedepends=(
    'imagemagick'      # resize app icon to multiple sizes during build
)
optdepends=(
    # Reading the current access point needs ONE of iw, iwgetid or nmcli.
    # iw ships with the kernel's wireless stack and nmcli with NetworkManager,
    # so on a machine that can join WiFi at all one of them is already there;
    # wireless_tools is only listed for hosts that have neither.
    'iw: read the current access point for rogue-AP detection'
    'networkmanager: alternative access-point reader (nmcli)'
    'wireless_tools: legacy access-point reader (iwgetid)'
)
install=maze-guard.install

source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/maze-guard-${pkgver}"

    # ── Application source → /opt/maze-guard ────────────────────────────────────
    install -dm755 "$pkgdir/opt/maze-guard"
    cp -r maze main.py "$pkgdir/opt/maze-guard/"
    # main.py and maze/helper.py are entry points and must be executable. The
    # .install scriptlet used to chmod them to 755 AFTER pacman had recorded
    # them as 644, so the package permanently disagreed with the disk and every
    # `pacman -Qkk` reported a permissions mismatch. Ship the real modes here
    # instead, and let the database be right.
    chmod 755 "$pkgdir/opt/maze-guard/main.py" "$pkgdir/opt/maze-guard/maze/helper.py"
    [[ -f pyproject.toml   ]] && install -m644 pyproject.toml   "$pkgdir/opt/maze-guard/"
    [[ -f requirements.txt ]] && install -m644 requirements.txt "$pkgdir/opt/maze-guard/"
    [[ -d assets ]] && cp -r assets "$pkgdir/opt/maze-guard/"
    [[ -f MAZE.png ]] && install -m644 MAZE.png "$pkgdir/opt/maze-guard/"

    # ── Launcher → /usr/bin/maze-guard ───────────────────────────────────────────
    install -dm755 "$pkgdir/usr/bin"
    install -m755 /dev/stdin "$pkgdir/usr/bin/maze-guard" << 'LAUNCHER'
#!/usr/bin/env bash
exec /opt/maze/venv/bin/python3 /opt/maze-guard/main.py "$@"
LAUNCHER

    # ── Privileged helper daemon (systemd) ─────────────────────────────────
    # Runs as root so the GUI never needs a sudo password. Access to its socket
    # (/run/maze/maze.sock) is gated by the 'maze' group.
    install -dm755 "$pkgdir/usr/lib/systemd/system"
    install -m644 /dev/stdin "$pkgdir/usr/lib/systemd/system/maze-guard.service" << 'UNIT'
[Unit]
Description=Maze Guard privileged helper
After=network.target

[Service]
Type=simple
ExecStart=/opt/maze/venv/bin/python3 /opt/maze-guard/maze/helper.py
Restart=on-failure
RestartSec=2
# The helper exits within a second of SIGTERM; anything longer is a wedge
# (a torn-down environment under a running process, a stuck sniff thread) and
# not worth systemd's 90 s default — it stalls every shutdown and upgrade.
TimeoutStopSec=10
# NO RuntimeDirectory=maze here. /run/maze is SHARED: maze-tools' maze-guardd
# binds /run/maze/guard.sock in it, and Maze Sentinel writes state files there.
# RuntimeDirectory makes systemd DELETE the whole directory when this unit stops,
# so every restart of this helper — a package upgrade is enough — wiped guard.sock
# out from under a still-running maze-guardd. Maze Connect's killswitch view then
# hung on "Reading killswitches…" forever, because the socket it dials had
# silently ceased to exist while the daemon owning it still thought it was
# listening. maze-tools' own unit carries the same warning. The helper creates and
# permissions the directory itself in _ensure_sock_dir(), so nothing is lost.
# Conservative hardening: ProtectSystem stays 'true' (not 'strict') so firewalld
# can write /etc/firewalld; kernel-tunable and address-family locks are omitted
# because the helper writes sysctl and sniffs via AF_PACKET.
ProtectHome=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectSystem=true
ProtectHostname=true
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
# Sandbox (2026-09). Everything below leaves what the helper really does intact
# — sniffing (AF_PACKET), sysctl writes (so no ProtectKernelTunables), firewalld
# and systemd over D-Bus, polkit — and takes away what it never needs: loading
# kernel modules, the clock, realtime scheduling, new namespaces, foreign-ABI
# syscalls, raw devices, and every syscall outside the normal service set
# (answered with EPERM, not a kill, so a surprise shows up as an error in the
# journal instead of a dead helper). Verify on a machine: sudo maze-sandbox-check
# Relax one directive locally if ever needed: sudo systemctl edit maze-guard
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectKernelModules=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
UNIT

    # ── polkit: consent for turning protections off ────────────────────────
    # Without this action registered, the helper refuses every destructive
    # request rather than performing it unauthenticated — so it ships with the
    # daemon, not as an optional extra.
    install -dm755 "$pkgdir/usr/share/polkit-1/actions"
    # Local builds stage it at the tarball root; a GitHub-tag tarball keeps the
    # repository layout. Accept either so both build paths work.
    _policy="org.mazeguard.policy"
    [[ -f "$_policy" ]] || _policy="packaging/org.mazeguard.policy"
    install -m644 "$_policy" \
        "$pkgdir/usr/share/polkit-1/actions/org.mazeguard.policy"

    # ── sysusers: create the 'maze' group that gates the helper socket ──────
    install -dm755 "$pkgdir/usr/lib/sysusers.d"
    install -m644 /dev/stdin "$pkgdir/usr/lib/sysusers.d/maze-guard.conf" << 'SYSUSERS'
g maze -
SYSUSERS

    # ── .desktop entry (application menu) ──────────────────────────────────
    install -dm755 "$pkgdir/usr/share/applications"
    install -m644 /dev/stdin "$pkgdir/usr/share/applications/maze-guard.desktop" << 'DESKTOP'
[Desktop Entry]
Version=1.1
Type=Application
Name=Maze Guard
GenericName=Network Security Monitor
Comment=Public WiFi protection — MITM detection, firewall
Exec=/usr/bin/maze-guard
Icon=maze-guard
Terminal=false
Categories=Network;Security;System;
Keywords=security;wifi;network;firewall;privacy;mitm;vpn;
StartupNotify=true
StartupWMClass=maze-guard
X-GNOME-UsesNotifications=true
DESKTOP

    # ── Autostart entry (start hidden in the system tray on login) ─────────
    install -dm755 "$pkgdir/etc/xdg/autostart"
    install -m644 /dev/stdin "$pkgdir/etc/xdg/autostart/maze-guard.desktop" << 'AUTOSTART'
[Desktop Entry]
Version=1.1
Type=Application
Name=Maze Guard
GenericName=Network Security Monitor
Comment=Start Maze Guard minimized in the system tray
Exec=/usr/bin/maze-guard --background
Icon=maze-guard
Terminal=false
Categories=Network;Security;System;
StartupNotify=false
StartupWMClass=maze-guard
X-GNOME-Autostart-enabled=true
AUTOSTART

    # ── Icons ──────────────────────────────────────────────────────────────
    # Pre-rendered by tools/make_logo.py (16-32 carry the heavier small mark).
    for size in 16 22 24 32 48 64 128 256 512; do
        install -Dm644 "maze/gui/logo/maze-guard-${size}.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/maze-guard.png"
    done
    install -Dm644 maze/gui/logo/maze-guard.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/maze-guard.svg"

    # ── License ────────────────────────────────────────────────────────────
    install -dm755 "$pkgdir/usr/share/licenses/$pkgname"
    [[ -f LICENSE ]] && install -m644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/"
}
